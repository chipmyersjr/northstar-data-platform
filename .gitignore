# VS Code machine-specific settings; allow shared project configuration
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# Temporary files, editor backups, and logs
tmp/
temp/
*.tmp
*.temp
*.log
*.swp
*.swo
*~

